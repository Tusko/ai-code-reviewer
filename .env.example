# Your GitLab instance URL (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# A Personal Access Token (PAT) with `api` scope
GITLAB_TOKEN=your_gitlab_token_here

# A secret token you set when creating the Webhook (optional but recommended)
WEBHOOK_SECRET=your_secret_token_here

# The Ollama model to use.
# 16 GB RAM: prefer qwen2.5-coder:7b (~5 GB) or a 12B QAT build (~7 GB).
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://host.docker.internal:11434

# Context and generation limits. Keep num_ctx low on 16 GB to avoid swap thrash.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=320
# Metal default. Do not lower this — 128 slows prompt eval 2-4x.
OLLAMA_NUM_BATCH=512

# Surrounding-file context. Off by default: it roughly doubles input tokens
# and adds one GitLab file fetch per file, for marginal review quality gain.
INCLUDE_FILE_CONTEXT=false
CONTEXT_WINDOW=15

# Tone. true: a meme on the summary note, and Sidorovich voice on inline
# findings (OpenRouter rewrite of the dry Ollama review). false: dry
# comments end to end. Voice never invents or drops issues; a failed
# rewrite posts the original review.
SNARK=true

# Sidorovich (release/hotfix roast + inline comment voice). Coder models
# cannot write surzhyk, so this runs on OpenRouter. Empty key, or any
# OpenRouter failure: roast → plain commit digest, inline voice → dry
# review. Finding detection is always Ollama.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Budget for the commit roast.
OPENROUTER_MAX_TOKENS=512
# Budget for the inline voice rewrite. It re-emits the whole finding
# including *Fix:* code fences, so it needs much more room — too low and
# every multi-finding review silently posts dry.
OPENROUTER_VOICE_MAX_TOKENS=2048
# true lets a local coder model attempt the roast when OpenRouter is
# unavailable. Off by default: qwen2.5-coder writing Ukrainian surzhyk is
# gibberish, and a plain commit digest is more useful than that.
SIDOROVICH_OLLAMA_FALLBACK=false

# Deadlines and limits.
PER_FILE_TIMEOUT_S=90
MR_TIMEOUT_S=480
MAX_FILES=40
QUEUE_MAXSIZE=32

# How many recent diff fingerprints to remember, to skip re-reviewing an
# MR whose diff has not changed since its last completed review.
DEDUPE_CACHE_SIZE=256

# Your Cloudflare Tunnel token
TUNNEL_TOKEN=your_tunnel_token_here
