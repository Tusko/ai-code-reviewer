# Your GitLab instance URL (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# A Personal Access Token (PAT) with `api` scope
GITLAB_TOKEN=your_gitlab_token_here

# A secret token you set when creating the Webhook (optional but recommended)
WEBHOOK_SECRET=your_secret_token_here

# The Ollama model to use.
# 16 GB RAM: prefer qwen2.5-coder:7b (~5 GB) or gemma4:12b-it-qat (~7 GB).
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://host.docker.internal:11434

# Context limits — keep low on 16 GB to avoid swap thrashing / hung reviews.
# gemma4:12b-it-qat: use 8192. qwen2.5-coder:7b: can try 16384.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
CONTEXT_WINDOW=25

# Your Cloudflare Tunnel token
TUNNEL_TOKEN=your_tunnel_token_here
