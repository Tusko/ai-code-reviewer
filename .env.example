# Your GitLab instance URL (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com

# A Personal Access Token (PAT) with `api` scope
GITLAB_TOKEN=your_gitlab_token_here

# A secret token you set when creating the Webhook (optional but recommended)
WEBHOOK_SECRET=your_secret_token_here

# The account GITLAB_TOKEN authenticates as. Leave empty in the common case —
# the bot asks GitLab who it is the first time it needs to know. Only set
# this if that lookup is blocked (e.g. a token without permission to read its
# own user). Without it, a locked-down token cannot tell its own comments
# from a human's, so /review and /sidorovich stop fail closed and are
# silently ignored — see "Comment guardrails" in README.md.
SIDOROVICH_BOT_USERNAME=

# The Ollama model to use.
# 16 GB RAM: prefer qwen2.5-coder:7b (~5 GB) or a 12B QAT build (~7 GB).
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://host.docker.internal:11434

# Context and generation limits. Keep num_ctx low on 16 GB to avoid swap thrash.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=320
# Metal default. Do not lower this — 128 slows prompt eval 2-4x.
OLLAMA_NUM_BATCH=512

# Surrounding-file context. Off by default: it roughly doubles input tokens
# and adds one GitLab file fetch per file, for marginal review quality gain.
INCLUDE_FILE_CONTEXT=false
CONTEXT_WINDOW=15

# Tone. true: a meme on the summary note, and Sidorovich voice on inline
# findings (a second OpenRouter call rewrites the dry review from
# OPENROUTER_REVIEW_MODEL below). false: dry comments end to end. Voice
# never invents or drops issues; a failed rewrite posts the original review.
SNARK=true

# Sidorovich (release/hotfix roast + inline comment voice). Coder models
# cannot write surzhyk, so this runs on OpenRouter. Empty key, or any
# OpenRouter failure: roast → plain commit digest, inline voice → dry
# review. Finding detection is a separate OpenRouter call — see
# OPENROUTER_REVIEW_MODEL under "Review backend" below.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Comma-separated models tried after OPENROUTER_MODEL, inside the same
# request. `:free` variants are refused outright — they share one saturated
# pool, 429 constantly, and trip the voice breaker. A `:free` suffix anywhere
# in these settings is stripped at startup and logged.
# Diagnose a 429 with: python3 scripts/openrouter_check.py --env .env
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it
# Budget for the commit roast.
OPENROUTER_MAX_TOKENS=1024
# Budget for the inline voice rewrite. It re-emits the whole finding
# including *Fix:* code fences, so it needs much more room — too low and
# every multi-finding review silently posts dry.
# Unset, it tracks REVIEW_MAX_OUTPUT_TOKENS automatically (x1.5), which is
# what keeps the voice able to reproduce a full-length finding. Setting it
# empty is not the same as unsetting it: env_int would warn on every boot.
# OPENROUTER_VOICE_MAX_TOKENS=6144
# true lets a local coder model attempt the roast when OpenRouter is
# unavailable. Off by default: qwen2.5-coder writing Ukrainian surzhyk is
# gibberish, and a plain commit digest is more useful than that.
SIDOROVICH_OLLAMA_FALLBACK=false

# MR hygiene. Before reviewing any code the bot checks the MR itself: the
# title must start with a bare ticket key (`MONO-1628: ...`, optionally behind
# `Draft:`/`WIP:`), and the MR must have an assignee or a reviewer. A wrapped
# key like `fix(MONO-1628): ...` is rejected — GitLab cannot link it to the
# issue. Set your own regex here to change the rule.
MR_TITLE_PATTERN=^(?:Draft:\s*|WIP:\s*)?[A-Z][A-Z0-9]+-\d+: .+

# Deadlines and limits.
PER_FILE_TIMEOUT_S=90
MR_TIMEOUT_S=480
MAX_FILES=40
QUEUE_MAXSIZE=32

# How many recent diff fingerprints to remember, to skip re-reviewing an
# MR whose diff has not changed since its last completed review.
DEDUPE_CACHE_SIZE=256

# --- Review backend ---
# Code review runs on OpenRouter, not Ollama. OPENROUTER_API_KEY (above) is
# required for review to produce any output at all, not only for the
# Sidorovich voice.
OPENROUTER_REVIEW_MODEL=poolside/laguna-s-2.1
# Comma-separated models tried after OPENROUTER_REVIEW_MODEL, inside the same
# request. Empty by default: a paid model already reroutes across providers
# on its own.
OPENROUTER_REVIEW_FALLBACK_MODELS=
# Deliberately below the model's 1_048_576-token window; prompt tokens are
# billed. Raise it to use more of the window.
REVIEW_CONTEXT_TOKENS=262144
# Deliberately below the model's 131_072-token ceiling. A single-file review
# needing more than this is producing a wall of comments, which the ladder
# in reviewer/pipeline.py prevents.
REVIEW_MAX_OUTPUT_TOKENS=4096

# --- Comment guardrails ---
# false silences the bot on every webhook without touching the GitLab
# webhook config.
SIDOROVICH_ENABLED=true
# Reviewable files above which the MR gets one note instead of a per-file
# review. See "Comment guardrails" in README.md.
MAX_MR_FILES=60
# Comments the bot may post in one MR across its whole lifetime (inline
# discussions, summaries, the oversized note). /review resets the counter.
MR_COMMENT_BUDGET=30
# Reviewed hunk keys retained per MR before the oldest are dropped.
LEDGER_MAX_HUNKS=2000

# Your Cloudflare Tunnel token
TUNNEL_TOKEN=your_tunnel_token_here
